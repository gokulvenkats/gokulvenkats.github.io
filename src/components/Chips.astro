---
interface Props {
  label: string;
  category?: string;
  href?: string;
  variant?: "default" | "accent" | "subtle";
}

const { label, category, href, variant = "default" } = Astro.props;

const variantClasses = {
  default: "bg-slate-900/5 dark:bg-white/10 text-slate-800 dark:text-slate-200 border-slate-900/10 dark:border-white/10 hover:border-sky-400 hover:text-sky-600 dark:hover:text-sky-400",
  accent: "bg-sky-500/10 dark:bg-sky-400/15 text-sky-700 dark:text-sky-300 border-sky-500/20 dark:border-sky-400/30 hover:bg-sky-500/20",
  subtle: "bg-black/5 dark:bg-white/5 text-slate-600 dark:text-slate-400 border-transparent",
};

const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium border transition-all duration-150",
    variantClasses[variant],
    href ? "hover:scale-105 cursor-pointer" : "",
  ]}
>
  {category && <span class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500">{category}:</span>}
  <span>{label}</span>
</Tag>