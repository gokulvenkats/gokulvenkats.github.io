---
const pathname = Astro.url.pathname;

const navItems = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
];

const isActive = (href: string) => {
  if (href === "/") {
    return pathname === "/";
  }
  return pathname.startsWith(href);
};
---

<header class="px-4 sm:px-8 pt-6 sm:pt-8 pb-4 border-b border-black/5 dark:border-white/5">
  <nav class="flex items-center justify-between">
    <!-- Brand Logo / Terminal Badge -->
    <a
      href="/"
      class="group flex items-center gap-2.5 font-bold text-base sm:text-lg text-slate-900 dark:text-white tracking-tight hover:opacity-90 transition-opacity"
    >
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-sky-500/10 dark:bg-sky-400/20 text-sky-600 dark:text-sky-400 border border-sky-500/20 dark:border-sky-400/30 text-sm font-semibold font-mono group-hover:scale-105 transition-transform">
        GV
      </span>
      <span class="hidden xs:inline sm:inline">gokul.dev</span>
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
    </a>

    <!-- Navigation Links & Theme Toggle -->
    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center gap-1 sm:gap-1.5 text-xs sm:text-sm font-medium">
        {
          navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "px-3.5 py-1.5 rounded-lg transition-all duration-150",
                    active
                      ? "bg-slate-900/10 dark:bg-white/15 text-sky-600 dark:text-sky-400 font-semibold"
                      : "text-slate-600 dark:text-slate-300 hover:bg-slate-900/5 dark:hover:bg-white/10 hover:text-slate-900 dark:hover:text-white",
                  ]}
                >
                  {item.name}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="h-4 w-[1px] bg-slate-300 dark:bg-slate-700 mx-1.5"></div>

      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-900/5 dark:hover:bg-white/10 hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        <!-- Sun icon (for dark mode) -->
        <svg
          class="w-4 h-4 sm:w-5 sm:h-5 hidden dark:block"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <!-- Moon icon (for light mode) -->
        <svg
          class="w-4 h-4 sm:w-5 sm:h-5 block dark:hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  const initThemeToggle = () => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;

    btn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  };

  initThemeToggle();
  document.addEventListener("astro:after-swap", initThemeToggle);
</script>
