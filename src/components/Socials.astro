---
import LinkedIn from "../../public/icons/linkedin.svg?raw";
import Github from "../../public/icons/github.svg?raw";
import X from "../../public/icons/x.svg?raw";
import Youtube from "../../public/icons/youtube.svg?raw";

const username = "gokulvenkats";

const socialMedia = [
  {
    name: "GitHub",
    url: `https://github.com/${username}`,
    icon: Github,
  },
  {
    name: "LinkedIn",
    url: `https://linkedin.com/in/${username}`,
    icon: LinkedIn,
  },
  {
    name: "X (Twitter)",
    url: `https://x.com/${username}`,
    icon: X,
  },
  {
    name: "YouTube",
    url: `https://www.youtube.com/@${username}`,
    icon: Youtube,
  },
];
---

<div class="flex flex-wrap justify-center items-center gap-3 my-4">
  {
    socialMedia.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noreferrer noopener"
        class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-900/5 dark:bg-white/5 border border-slate-900/10 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:text-sky-600 dark:hover:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-950/40 hover:border-sky-300 dark:hover:border-sky-500/40 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200"
        aria-label={link.name}
        title={link.name}
      >
        <span class="w-5 h-5 flex items-center justify-center [&>svg]:w-5 [&>svg]:h-5 [&>svg]:fill-current">
          <Fragment set:html={link.icon} />
        </span>
      </a>
    ))
  }

  <!-- Email Link -->
  <a
    href="mailto:gokul.venkatesan.gv@gmail.com"
    class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-900/5 dark:bg-white/5 border border-slate-900/10 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:text-sky-600 dark:hover:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-950/40 hover:border-sky-300 dark:hover:border-sky-500/40 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200"
    aria-label="Email Gokul"
    title="Email me"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
  </a>
</div>
