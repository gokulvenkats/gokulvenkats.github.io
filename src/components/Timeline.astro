---
interface WorkItem {
  name: string;
  role: string;
  yearOfWork: string;
  presentlyWorking?: boolean;
  description: string;
  technologies?: string[];
  projects?: {
    name: string;
    description: string;
  }[];
  bullets?: string[];
}

interface Props {
  works: {
    companies: WorkItem[];
  };
}

const { works } = Astro.props;
---

<div class="relative border-s-2 border-sky-500/30 dark:border-sky-400/20 ms-3 sm:ms-4 my-6 space-y-8">
  {
    works.companies.map((company) => (
      <div class="relative ps-6 sm:ps-8 group">
        <!-- Node indicator -->
        <span class="absolute -start-[9px] top-1.5 flex h-4 w-4 items-center justify-center rounded-full bg-white dark:bg-slate-900 ring-4 ring-sky-500/20 dark:ring-sky-400/20 border-2 border-sky-500 dark:border-sky-400 group-hover:scale-125 group-hover:ring-sky-500/40 transition-all">
          {company.presentlyWorking && (
            <span class="h-1.5 w-1.5 rounded-full bg-sky-500 animate-pulse" />
          )}
        </span>

        <!-- Role & Company Header -->
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1.5">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
              {company.role || "Software Engineer"}
            </h3>
            <span class="text-sky-600 dark:text-sky-400 font-semibold text-sm">
              @{company.name}
            </span>
            {company.presentlyWorking && (
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400 border border-emerald-500/30">
                Present
              </span>
            )}
          </div>
          <time class="text-xs font-semibold text-slate-500 dark:text-slate-400 whitespace-nowrap">
            {company.yearOfWork}
          </time>
        </div>

        <!-- Description -->
        <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed mb-3">
          {company.description}
        </p>

        <!-- Bulleted details if available -->
        {company.bullets && company.bullets.length > 0 && (
          <ul class="space-y-1.5 mb-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
            {company.bullets.map((bullet) => (
              <li class="flex items-start gap-2">
                <span class="text-sky-500 mt-1 flex-shrink-0 font-bold">›</span>
                <span class="leading-relaxed">{bullet}</span>
              </li>
            ))}
          </ul>
        )}

        <!-- Projects summary if available -->
        {company.projects && company.projects.length > 0 && (
          <div class="space-y-2 mb-3 bg-black/5 dark:bg-white/5 p-3 rounded-xl border border-black/5 dark:border-white/5">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              Key Focus
            </div>
            {company.projects.map((project) => (
              <div class="text-xs">
                <span class="font-bold text-slate-900 dark:text-white">{project.name}: </span>
                <span class="text-slate-600 dark:text-slate-300">{project.description}</span>
              </div>
            ))}
          </div>
        )}

        <!-- Technologies chips -->
        {company.technologies && company.technologies.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-1">
            {company.technologies.map((tech) => (
              <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-900/5 dark:bg-white/10 text-slate-700 dark:text-slate-300 border border-slate-900/10 dark:border-white/10">
                {tech}
              </span>
            ))}
          </div>
        )}
      </div>
    ))
  }
</div>