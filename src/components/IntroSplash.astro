<style>
  :global(html.no-intro) .intro-splash-overlay {
    display: none !important;
  }

  .intro-splash-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(248, 250, 252, 0.97);
