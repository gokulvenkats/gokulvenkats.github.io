---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import IntroSplash from "../components/IntroSplash.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Gokul V — Software Engineer & SRE",
  description = "Software Engineer & SRE at Cisco with expertise in Python, JavaScript/TypeScript, cloud infrastructure, microservices, and DevOps.",
  image = "/gokul-avatar.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://gokulvenkats.github.io");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Dynamic Favicons (White in dark mode, Black in light mode) -->
    <link id="favicon-ico" rel="icon" type="image/x-icon" href="/favicon-black/favicon.ico" />
    <link id="favicon-32" rel="icon" type="image/png" sizes="32x32" href="/favicon-black/favicon-32x32.png" />
    <link id="favicon-16" rel="icon" type="image/png" sizes="16x16" href="/favicon-black/favicon-16x16.png" />
    <link id="favicon-svg" rel="icon" type="image/svg+xml" href="/favicon-black/favicon.svg" />
    <link id="favicon-apple" rel="apple-touch-icon" sizes="180x180" href="/favicon-black/apple-touch-icon.png" />
    <link id="favicon-manifest" rel="manifest" href="/favicon-black/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Fira Mono & Fira Code -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Fira+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Anti-FOUC Dark Mode & Favicon initialization script -->
    <script is:inline>
      function updateFavicon(isDark) {
        const folder = isDark ? "favicon-white" : "favicon-black";
        const targets = [
          { id: "favicon-ico", href: `/${folder}/favicon.ico` },
          { id: "favicon-32", href: `/${folder}/favicon-32x32.png` },
          { id: "favicon-16", href: `/${folder}/favicon-16x16.png` },
          { id: "favicon-svg", href: `/${folder}/favicon.svg` },
          { id: "favicon-apple", href: `/${folder}/apple-touch-icon.png` },
          { id: "favicon-manifest", href: `/${folder}/site.webmanifest` },
        ];

        targets.forEach(({ id, href }) => {
          const el = document.getElementById(id);
          if (el) {
            el.href = href;
          }
        });
      }
      window.updateFavicon = updateFavicon;

      const getInitialTheme = () => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      };

      const theme = getInitialTheme();
      const isDark = theme === "dark";
      if (isDark) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
      localStorage.setItem("theme", theme);
      updateFavicon(isDark);

      // System color scheme change listener
      if (window.matchMedia) {
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (!localStorage.getItem("theme")) {
            const systemDark = e.matches;
            if (systemDark) {
              document.documentElement.classList.add("dark");
            } else {
              document.documentElement.classList.remove("dark");
            }
            updateFavicon(systemDark);
          }
        });
      }

      // Check if user has already seen the intro splash (supports ?intro or ?replay to rewatch)
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const forceIntro = urlParams.has("intro") || urlParams.has("replay");
        const hasSeenIntro = !forceIntro && (
          (typeof sessionStorage !== "undefined" && sessionStorage.getItem("gokul_intro_seen")) ||
          (typeof localStorage !== "undefined" && localStorage.getItem("gokul_intro_seen"))
        );
        if (hasSeenIntro) {
          document.documentElement.classList.add("no-intro");
        } else {
          document.documentElement.classList.remove("no-intro");
        }
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen py-3 sm:py-6 md:py-10 px-2 sm:px-4 md:px-8 flex flex-col justify-center items-center antialiased">
    <IntroSplash />
    <div class="font-mono w-full max-w-4xl glass-container min-h-[calc(100vh-1.5rem)] sm:min-h-[calc(100vh-3rem)] md:min-h-[calc(100vh-5rem)] flex flex-col justify-between">
      <Header />
      <main class="flex-1 px-4 sm:px-8 md:px-12 py-6 sm:py-8">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
