---
import SiteLayout from "../layouts/SiteLayout.astro";
import Timeline from "../components/Timeline.astro";
import Chips from "../components/Chips.astro";

const works = {
  companies: [
    {
      name: "Cisco Systems",
      role: "Site Reliability Engineer / Software Engineer",
      yearOfWork: "July 2022 – Present",
      presentlyWorking: true,
      description:
        "Responsible for the reliability, scalability, and automated orchestration of Cisco SD-WAN infrastructure across global deployments.",
      bullets: [
        "Architect and implement automation software to orchestrate, configure, and monitor WAN network devices.",
        "Ensure high availability, resilience, and automated fault recovery across distributed cloud systems.",
        "Design telemetry pipelines and SLO/SLI observability dashboards for proactive incident response.",
      ],
      technologies: [
        "Python",
        "SD-WAN",
        "Docker",
        "Kubernetes",
        "Linux",
        "SRE",
        "Prometheus",
      ],
    },
    {
      name: "Wipro Technologies",
      role: "Senior Software Engineer (Client: Apple Inc.)",
      yearOfWork: "2020 – 2022",
      presentlyWorking: false,
      description:
        "Engineered scalable data ETL pipelines, container infrastructure, and telemetry tracking for enterprise data services.",
      bullets: [
        "Designed and maintained core frameworks for automated ETL pipelines processing multi-source structured data.",
        "Containerized application workloads and managed deployments using Docker and Kubernetes clusters.",
        "Architected queue processing and time-series metadata storage utilizing MongoDB.",
        "Engineered custom log handlers for Splunk and real-time operational metrics with Prometheus and Grafana.",
      ],
      technologies: [
        "Python",
        "Docker",
        "Kubernetes",
        "MongoDB",
        "Prometheus",
        "Grafana",
        "Splunk",
        "ETL",
      ],
    },
    {
      name: "Elait IT Technologies",
      role: "Technology Lead",
      yearOfWork: "2015 – 2020",
      presentlyWorking: false,
      description:
        "Led solution architecture and end-to-end development of enterprise web platforms and backend API microservices.",
      bullets: [
        "Architected enterprise-level web applications and backend REST APIs with Python and relational database engines.",
        "Led UI/UX prototyping and frontend development using modern JavaScript, React, and Angular.",
        "Administered cloud infrastructure, managed deployment environments, and instituted automated testing standards.",
      ],
      technologies: [
        "Python",
        "JavaScript",
        "React",
        "Angular",
        "REST APIs",
        "Cloud & CI/CD",
        "PostgreSQL",
      ],
    },
  ],
};

const skillCategories = [
  {
    category: "Languages & Systems",
    skills: [
      "Python",
      "TypeScript",
      "JavaScript",
      "SQL",
      "Bash / Shell",
      "Linux",
    ],
  },
  {
    category: "DevOps & Infrastructure",
    skills: [
      "Docker",
      "Kubernetes",
      "CI/CD",
      "SD-WAN",
      "Git",
      "Microservices",
      "Infrastructure as Code",
    ],
  },
  {
    category: "Observability & Data",
    skills: [
      "Prometheus",
      "Grafana",
      "Splunk",
      "MongoDB",
      "ETL Pipelines",
      "Time Series Metrics",
    ],
  },
  {
    category: "Web & Architecture",
    skills: [
      "RESTful APIs",
      "Astro",
      "React",
      "Node.js",
      "Tailwind CSS",
      "Distributed Systems",
    ],
  },
];
---

<SiteLayout
  title="About — Gokul Venkatesan"
  description="Background, career history, technical competencies, and education of Gokul Venkatesan, Senior Software Engineer & SRE."
>
  <div class="max-w-3xl mx-auto space-y-12">
    <!-- Executive Summary -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
        <img
          class="w-32 h-32 rounded-2xl object-cover object-center shadow-lg ring-2 ring-sky-500/30 flex-shrink-0"
          src="/gokul-avatar.jpg"
          alt="Gokul Venkatesan"
          width="128"
          height="128"
        />
        <div class="space-y-3 text-center sm:text-left">
          <h1 class="name">About</h1>
          <p class="para">
            I am a Site Reliability Engineer and Software Engineer with over 8
            years of experience designing, scaling, and operating
            mission-critical distributed systems.
          </p>
          <p class="para">
            Currently at Cisco, I focus on network orchestration and
            high-availability infrastructure for SD-WAN. My engineering approach
            emphasizes robust automation, observability, clean system design,
            and continuous operational resilience.
          </p>
        </div>
      </div>

      <!-- Professional philosophy quote -->
      <blockquote
        class="p-4 rounded-xl bg-sky-500/5 dark:bg-sky-400/10 border-s-4 border-sky-500 italic text-xs sm:text-sm text-slate-700 dark:text-slate-300"
      >
        “Sometimes, it is the very people who no one imagines anything of who do
        the things no one can imagine.”
        <footer
          class="mt-1 font-semibold not-italic text-sky-600 dark:text-sky-400"
        >
          — Alan Turing
        </footer>
      </blockquote>
    </section>

    <!-- Technical Competencies -->
    <section class="space-y-4">
      <h2 class="subtitle">Technical Competencies</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        {
          skillCategories.map((group) => (
            <div class="glass-card p-4 space-y-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">
                {group.category}
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {group.skills.map((skill) => (
                  <Chips label={skill} variant="default" />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Professional Experience Timeline -->
    <section class="space-y-4">
      <h2 class="subtitle">Professional Experience</h2>
      <Timeline works={works} />
    </section>

    <!-- Education -->
    <section class="space-y-4">
      <h2 class="subtitle">Education</h2>
      <div class="glass-card p-5 space-y-2">
        <div
          class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1"
        >
          <div>
            <h3 class="font-bold text-base text-slate-900 dark:text-white">
              Bachelor of Engineering (B.E.) in Electronics & Communication
            </h3>
            <p
              class="text-xs sm:text-sm text-sky-600 dark:text-sky-400 font-semibold"
            >
              Anna University, Chennai, India
            </p>
          </div>
          <span
            class="text-xs font-semibold text-slate-500 dark:text-slate-400"
          >
            2011 – 2015
          </span>
        </div>
        <p
          class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed pt-1"
        >
          Graduated with honors. Served as Student Chairman of the IETE
          Association, coordinating technical symposiums, seminars, and
          competitive collegiate events.
        </p>
      </div>
    </section>

    <!-- Professional Contact Section -->
    <section
      class="p-6 rounded-2xl bg-gradient-to-r from-sky-500/10 via-pink-500/10 to-amber-500/10 border border-white/60 dark:border-white/10 text-center space-y-3"
    >
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">
        Get in Touch
      </h2>
      <p
        class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-md mx-auto"
      >
        Interested in discussing distributed systems, infrastructure
        reliability, or technical collaborations? Feel free to reach out.
      </p>
      <div class="flex items-center justify-center gap-3 pt-1">
        <a
          href="mailto:gokul.venkatesan.gv@gmail.com"
          class="inline-flex items-center gap-2 px-5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-sky-600 text-white hover:bg-sky-500 shadow-md transition-all"
        >
          <span>Send an Email</span>
        </a>
        <a
          href="https://linkedin.com/in/gokulvenkats"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white/70 dark:bg-slate-800/70 text-slate-800 dark:text-slate-200 border border-slate-900/10 dark:border-white/10 hover:border-sky-400 transition-all"
        >
          <span>LinkedIn</span>
        </a>
      </div>
    </section>
  </div>
</SiteLayout>
