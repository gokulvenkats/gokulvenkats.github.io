---
import SiteLayout from "../layouts/SiteLayout.astro";
import Timeline from "../components/Timeline.astro";
import Chips from "../components/Chips.astro";

const works = {
  companies: [
    {
      name: "Cisco Systems, Inc.",
      role: "Software Engineer",
      yearOfWork: "July 2022 – Present",
      location: "Bengaluru, India",
      presentlyWorking: true,
      description:
        "As a Site Reliability Engineer (SRE), I optimize the performance and reliability of the infrastructure, ensuring its stability, scalability, and efficiency across global SD-WAN deployments.",
      bullets: [
        "Championed automation scripts for health checks and proactive performance monitoring.",
        "Collaboratively tackled complex WAN performance issues and upgrades, boosting application uptime and driving error reduction.",
        "Built resilient infrastructure for multi-cloud SD-WAN solutions, ensuring high availability and disaster recovery on controllers.",
      ],
      projects: [
        {
          name: "Cisco Catalyst SD-WAN Solution",
          client: "Cisco Systems Inc., USA",
          description:
            "Enhanced SD-WAN controller infrastructure to adapt to evolving requirements, optimized health check automation, and built multi-cloud disaster recovery architectures.",
        },
      ],
      technologies: [
        "Python",
        "SD-WAN",
        "Docker",
        "Kubernetes",
        "Linux / Ubuntu",
        "SRE & High Availability",
        "Prometheus",
      ],
    },
    {
      name: "Wipro Technologies Ltd.",
      role: "Senior Software Engineer",
      yearOfWork: "December 2020 – July 2022",
      location: "Bengaluru, India",
      presentlyWorking: false,
      description:
        "Built and deployed an enterprise ETL pipeline framework with expertise in managing diverse data formats and streamlining processing workflows for Apple Inc.",
      bullets: [
        "Developed ETL pipelines for diverse data sources using shared framework libraries and universal secrets managers.",
        "Employed MongoDB for queue and time-series metadata storage and monitored pipeline metrics with Prometheus.",
        "Containerized applications and workers using Docker and Kubernetes clusters.",
        "Created custom log handlers for Splunk and operational dashboards with Prometheus, Grafana, and Tableau.",
      ],
      projects: [
        {
          name: "Data Engineering Platform",
          client: "Apple Inc., USA",
          description:
            "Developing automated ETL pipelines for multi-source data processing, worker queue orchestration with MongoDB, container orchestration with K8s, and observability via Splunk and Prometheus.",
        },
      ],
      technologies: [
        "Python",
        "Docker",
        "Kubernetes",
        "MongoDB",
        "Prometheus",
        "Grafana",
        "Splunk",
        "Tableau",
        "ETL Frameworks",
      ],
    },
    {
      name: "Elait IT Technologies Pvt Ltd.",
      role: "Technology Lead",
      yearOfWork: "November 2015 – November 2020",
      location: "Chennai, India",
      presentlyWorking: false,
      description:
        "Built full-stack web applications and REST APIs, specializing in design, development, and deployment of enterprise-level applications, with skills in UI/UX prototyping and cloud infrastructure.",
      bullets: [
        "Architected enterprise-level web applications and backend REST APIs with Python (Django, Flask, Falcon) and relational databases.",
        "Led UI/UX prototyping and frontend development using modern JavaScript, React, and Angular.",
        "Administered cloud infrastructure across AWS and Azure, automated CI/CD deployment pipelines, and instituted unit testing programs.",
      ],
      projects: [
        {
          name: "Scala Transformation Parser & Lineage",
          client: "Santander Bank, London, UK",
          description:
            "Built generic parsers using Antlr4 to translate structured Scala & Spark transformation scripts for data flow analysis, lineage tracking, and code audits.",
        },
        {
          name: "Digital Term Life Insurance",
          client: "Lifefy Corp., Miami, USA",
          description:
            "Developed a robust web service REST API in Python paired with an Angular UI for seamless online life insurance underwriting, pricing, payment gateways, and e-signatures.",
        },
        {
          name: "Elait Business Portal",
          client: "Elait IT Technologies, Chennai",
          description:
            "Designed and built office productivity web apps with React to manage projects, HR, and finance, integrating Microsoft O365 services with Python REST APIs.",
        },
        {
          name: "Avance 360",
          client: "Madras Dyslexia Association, Chennai",
          description:
            "Digitized the clinical therapy workflow to capture student progress across activities and enable secure multi-stakeholder reporting.",
        },
        {
          name: "Smart Report Cards",
          client: "Report Bee, Chennai",
          description:
            "Developed an educational analytics system using Python's Matplotlib library to visualize academic progression from multiple Microsoft SQL Servers.",
        },
      ],
      technologies: [
        "Python (Django, Flask, Falcon)",
        "React",
        "Angular",
        "REST APIs",
        "Antlr4",
        "AWS & Azure",
        "PostgreSQL & MySQL",
      ],
    },
  ],
};

const certifications = [
  {
    title: "Azure AI Fundamentals",
    issuer: "Microsoft",
    code: "AI-900",
    description: "Foundational knowledge of machine learning and artificial intelligence concepts and related Microsoft Azure services.",
  },
  {
    title: "AWS Certified Developer – Associate",
    issuer: "Amazon Web Services (AWS)",
    code: "DVA-C01",
    description: "Validation of technical expertise in developing, deploying, and debugging cloud-based applications using AWS.",
  },
  {
    title: "AWS Technical Professional",
    issuer: "Amazon Web Services (AWS)",
    code: "Accreditation",
    description: "Core technical accreditation for designing and deploying resilient cloud workloads on AWS.",
  },
  {
    title: "Microsoft Technology Associate (MTA)",
    issuer: "Microsoft",
    code: "Fundamentals of C#",
    description: "Certified understanding of core software development concepts, object-oriented programming, and C# fundamentals.",
  },
];

const skillCategories = [
  {
    category: "Languages & Core",
    skills: [
      "Python",
      "TypeScript",
      "JavaScript",
      "Node.js",
      "Bash / Shell",
      "SQL",
      "MongoDB (NoSQL)",
      "C",
    ],
  },
  {
    category: "Frameworks & Libraries",
    skills: [
      "Django",
      "Flask",
      "Falcon",
      "React",
      "Angular",
      "Pandas",
      "Astro",
      "Tailwind CSS",
    ],
  },
  {
    category: "Cloud, DevOps & SRE",
    skills: [
      "Docker",
      "Kubernetes",
      "AWS",
      "Azure",
      "CI/CD",
      "SD-WAN",
      "Linux / Ubuntu",
      "Nginx",
      "Apache httpd",
      "uWSGI",
    ],
  },
  {
    category: "Observability & SCM",
    skills: [
      "Prometheus",
      "Grafana",
      "Splunk",
      "Tableau",
      "GitHub & GitLab",
      "Azure DevOps",
      "Figma",
      "Agile / Scrum",
    ],
  },
];
---

<SiteLayout
  title="About — Gokul Venkatesan"
  description="Background, career history, certifications, technical competencies, and education of Gokul Venkatesan, Senior Software Engineer & SRE."
>
  <div class="max-w-3xl mx-auto space-y-12">
    <!-- Executive Summary -->
    <section class="space-y-6">
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <h1 class="name">About</h1>
          <!-- Resume Download Button -->
          <a
            href="/resume.pdf"
            target="_blank"
            download="Gokul_Venkatesan_Resume.pdf"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:bg-sky-600 dark:hover:bg-sky-400 hover:text-white dark:hover:text-slate-900 shadow-md transition-all self-start sm:self-auto"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download Resume (PDF)</span>
          </a>
        </div>

        <p class="para">
          I am a Site Reliability Engineer and Software Engineer with over 8 years of experience designing, scaling, and operating mission-critical distributed systems and cloud infrastructure.
        </p>
        <p class="para">
          Currently at Cisco, I focus on network orchestration, automated health checks, and high-availability infrastructure for SD-WAN. My background spans data engineering at Apple Inc. via Wipro, full-stack microservices architecture at Elait IT, and deep hands-on expertise in Python, cloud systems, and telemetry.
        </p>

        <!-- Personal Sign-off -->
        <div class="pt-2 font-mono text-xs text-slate-600 dark:text-slate-400">
          <span class="font-bold text-slate-800 dark:text-slate-200">— Gokul Venkatesan</span>
          <span class="text-slate-400 dark:text-slate-500"> • Bengaluru & Chennai, India</span>
        </div>
      </div>

      <!-- Professional philosophy quote -->
      <blockquote
        class="p-4 rounded-xl bg-sky-500/5 dark:bg-sky-400/10 border-s-4 border-sky-500 italic text-xs sm:text-sm text-slate-700 dark:text-slate-300"
      >
        “Sometimes, it is the very people who no one imagines anything of who do
        the things no one can imagine.”
        <footer
          class="mt-1 font-semibold not-italic text-sky-600 dark:text-sky-400"
        >
          — Alan Turing
        </footer>
      </blockquote>
    </section>

    <!-- Certifications Section -->
    <section class="space-y-4">
      <div class="flex items-baseline justify-between">
        <h2 class="subtitle">Certifications</h2>
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Verified Credentials</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        {
          certifications.map((cert) => (
            <div class="glass-card p-4 space-y-2 border-s-4 border-s-sky-500">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-white leading-snug">
                  {cert.title}
                </h3>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-sky-500/10 text-sky-600 dark:text-sky-400 whitespace-nowrap">
                  {cert.code}
                </span>
              </div>
              <p class="text-xs font-semibold text-sky-600 dark:text-sky-400">
                {cert.issuer}
              </p>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                {cert.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Technical Competencies -->
    <section class="space-y-4">
      <h2 class="subtitle">Technical Competencies</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        {
          skillCategories.map((group) => (
            <div class="glass-card p-4 space-y-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">
                {group.category}
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {group.skills.map((skill) => (
                  <Chips label={skill} variant="default" />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Professional Experience Timeline -->
    <section class="space-y-4">
      <h2 class="subtitle">Professional Experience</h2>
      <Timeline works={works} />
    </section>

    <!-- Education -->
    <section class="space-y-4">
      <h2 class="subtitle">Education</h2>
      <div class="space-y-3">
        <!-- University -->
        <div class="glass-card p-5 space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <h3 class="font-bold text-base text-slate-900 dark:text-white">
                Bachelor’s of Engineering (B.E.) — Electronics & Communication
              </h3>
              <p class="text-xs sm:text-sm text-sky-600 dark:text-sky-400 font-semibold">
                Anna University, Chennai, India
              </p>
            </div>
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
              Graduated May 2015
            </span>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed pt-1">
            Served as Student’s Chairman of the IETE Association. Organized college technical ceremonies, symposiums, and sports competitions (Chess & Table Tennis).
          </p>
        </div>

        <!-- High School -->
        <div class="glass-card p-4 space-y-1">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <h3 class="font-bold text-sm text-slate-900 dark:text-white">
                Higher Secondary Certificate — Computer Science
              </h3>
              <p class="text-xs text-sky-600 dark:text-sky-400 font-semibold">
                Jayarani Matriculation Higher Secondary School, Salem, India
              </p>
            </div>
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
              2009 – 2011
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Languages Spoken -->
    <section class="space-y-3">
      <h2 class="subtitle">Languages</h2>
      <div class="flex flex-wrap gap-2 pt-1">
        <Chips label="English (Fluent)" variant="default" />
        <Chips label="Tamil (Native)" variant="default" />
        <Chips label="Kannada (Working Proficiency)" variant="default" />
      </div>
    </section>

    <!-- Professional Contact Section -->
    <section
      class="p-6 rounded-2xl bg-gradient-to-r from-sky-500/10 via-pink-500/10 to-amber-500/10 border border-white/60 dark:border-white/10 text-center space-y-4"
    >
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">
        Let's Connect
      </h2>
      <p
        class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-md mx-auto"
      >
        Open to discussions on distributed systems, SRE, network automation, or engineering collaborations.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-1">
        <a
          href="mailto:gokul.venkatesan@outlook.com"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-sky-600 text-white hover:bg-sky-500 shadow-md transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>gokul.venkatesan@outlook.com</span>
        </a>
        <a
          href="https://linkedin.com/in/gokulvenkats"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white/70 dark:bg-slate-800/70 text-slate-800 dark:text-slate-200 border border-slate-900/10 dark:border-white/10 hover:border-sky-400 transition-all"
        >
          <span>LinkedIn</span>
        </a>
        <a
          href="/resume.pdf"
          target="_blank"
          download="Gokul_Venkatesan_Resume.pdf"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white/70 dark:bg-slate-800/70 text-slate-800 dark:text-slate-200 border border-slate-900/10 dark:border-white/10 hover:border-sky-400 transition-all"
        >
          <span>Resume PDF</span>
        </a>
      </div>
    </section>
  </div>
</SiteLayout>
