---
import Layout from "../layouts/Layout.astro";
import Socials from "../components/Socials.astro";
import Chips from "../components/Chips.astro";

const pageTitle = "Gokul Venkatesan — Software Engineer & SRE";
const pageDescription = "Senior Software Engineer and SRE at Cisco specializing in distributed systems, cloud infrastructure, network orchestration, and reliability engineering.";

const coreSkills = [
  "Python",
  "TypeScript",
  "Docker",
  "Kubernetes",
  "SD-WAN",
  "Linux Systems",
  "Prometheus",
  "Grafana",
  "ETL Pipelines",
  "REST APIs",
];

const highlights = [
  {
    role: "Software Engineer / SRE",
    company: "Cisco Systems",
    period: "2022 — Present",
    highlight: "SD-WAN orchestration, network automation, and high-availability infrastructure scaling.",
  },
  {
    role: "Senior Software Engineer",
    company: "Wipro (Client: Apple Inc.)",
    period: "2020 — 2022",
    highlight: "Enterprise ETL data pipelines, Kubernetes containerization, and telemetry with Prometheus/Splunk.",
  },
  {
    role: "Technology Lead",
    company: "Elait IT Technologies",
    period: "2015 — 2020",
    highlight: "Full-stack application architecture, Python REST APIs, and automated CI/CD deployments.",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="space-y-12 sm:space-y-16">
    <!-- Hero Section -->
    <section class="flex flex-col items-center text-center max-w-2xl mx-auto space-y-6 pt-2">
      <!-- Profile Avatar -->
      <div class="relative group">
        <div class="absolute -inset-0.5 rounded-full bg-gradient-to-r from-sky-400 via-pink-400 to-amber-400 opacity-60 blur-sm group-hover:opacity-90 transition duration-300"></div>
        <img
          class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover object-center shadow-xl ring-4 ring-white/80 dark:ring-slate-800"
          src="/gokul-avatar.jpg"
          alt="Gokul Venkatesan"
          width="128"
          height="128"
        />
      </div>

      <!-- Identity & Bio -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Software Engineer & SRE @ Cisco
        </div>
        <h1 class="name">Gokul Venkatesan</h1>
        <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 max-w-xl mx-auto leading-relaxed">
          Site Reliability & Software Engineer with 8+ years of experience in distributed systems, network automation, and cloud infrastructure. Passionate about building resilient, high-performance systems.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-1">
        <a
          href="/about"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:bg-sky-600 dark:hover:bg-sky-400 hover:text-white dark:hover:text-slate-900 shadow-md hover:shadow-lg transition-all"
        >
          <span>View Career Experience</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="mailto:gokul.venkatesan.gv@gmail.com"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white/60 dark:bg-slate-800/60 text-slate-800 dark:text-slate-200 border border-slate-900/10 dark:border-white/10 hover:border-sky-400 hover:text-sky-600 dark:hover:text-sky-400 transition-all"
        >
          <span>Contact Me</span>
        </a>
      </div>

      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap justify-center gap-2 pt-2 max-w-lg">
        {coreSkills.map((skill) => (
          <Chips label={skill} variant="subtle" />
        ))}
      </div>

      <!-- Socials -->
      <Socials />
    </section>

    <!-- Engineering Disciplines -->
    <section class="space-y-4">
      <div class="text-center">
        <h2 class="subtitle">Core Competencies</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        <div class="glass-card p-5 space-y-2">
          <div class="w-8 h-8 rounded-lg bg-sky-500/10 dark:bg-sky-400/20 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-sm">
            01
          </div>
          <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">
            SRE & Infrastructure
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Optimizing performance and high availability for Cisco SD-WAN, orchestrating WAN devices, and automating system reliability.
          </p>
        </div>

        <div class="glass-card p-5 space-y-2">
          <div class="w-8 h-8 rounded-lg bg-sky-500/10 dark:bg-sky-400/20 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-sm">
            02
          </div>
          <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">
            Distributed Systems & APIs
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Architecting Python and TypeScript microservices, RESTful interfaces, and cloud application platforms for enterprise workloads.
          </p>
        </div>

        <div class="glass-card p-5 space-y-2">
          <div class="w-8 h-8 rounded-lg bg-sky-500/10 dark:bg-sky-400/20 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-sm">
            03
          </div>
          <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">
            Data Pipelines & Observability
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Managing containerized ETL data pipelines with Docker and Kubernetes, alongside telemetry with Prometheus, Grafana, and Splunk.
          </p>
        </div>
      </div>
    </section>

    <!-- Experience Snapshot -->
    <section class="space-y-4">
      <div class="flex items-end justify-between border-b border-black/5 dark:border-white/5 pb-3">
        <div>
          <h2 class="subtitle">Experience Overview</h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1">
            Proven engineering track record across leading technology organizations.
          </p>
        </div>
        <a
          href="/about"
          class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline inline-flex items-center gap-1 whitespace-nowrap"
        >
          Full Details
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="space-y-3">
        {highlights.map((item) => (
          <div class="glass-card p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">
                  {item.role}
                </h3>
                <span class="text-sky-600 dark:text-sky-400 font-semibold text-xs sm:text-sm">
                  @{item.company}
                </span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                {item.highlight}
              </p>
            </div>
            <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 whitespace-nowrap sm:text-right">
              {item.period}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>