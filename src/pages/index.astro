---
import Layout from "../layouts/Layout.astro";
import Socials from "../components/Socials.astro";
import Chips from "../components/Chips.astro";

// Dynamic calculation of career experience starting from November 2015
const careerStartDate = new Date("2015-11-01");
const yearsOfExperience = Math.floor(
  (Date.now() - careerStartDate.getTime()) / (1000 * 60 * 60 * 24 * 365.25)
);
const experienceYears = `${yearsOfExperience}+`;

const pageTitle = "Gokul Venkatesan — Software Engineer & AI Operations";
const pageDescription = `Software Engineer with ${experienceYears} years of experience in scalable distributed systems, microservices, AI engineering, and intelligent platform operations (AIOps) @ Cisco.`;

const coreSkills = [
  "Python",
  "REST APIs",
  "AI Engineering",
  "MLOps",
  "Generative AI",
  "Docker & K8s",
  "Web Apps",
];

const highlights = [
  {
    role: "Site Reliability & AI Operations Engineer",
    company: "Cisco Systems (IT)",
    period: "Sept 2024 — Present",
    presentlyWorking: true,
    summary:
      "Leading enterprise network platform reliability and AI operational workflows (AIOps) as Customer Zero across Cisco's global IT backbone. Driving zero-downtime controller lifecycles, enterprise RBAC governance, and automated telemetry across Catalyst Center, NSO, and Splunk Observability.",
    tags: ["Catalyst Center", "NSO", "Splunk Observability", "AIOps", "Python", "Enterprise Security"],
  },
  {
    role: "Software Engineer / SRE",
    company: "Cisco Systems (SD-WAN)",
    period: "July 2022 — Sept 2024",
    presentlyWorking: false,
    summary:
      "Architected high-availability controller infrastructure and automated disaster recovery for global enterprise SD-WAN deployments. Engineered proactive health diagnostics and telemetry routines that dramatically minimized system MTTR.",
    tags: ["SD-WAN", "Multi-Cloud HA", "Kubernetes", "Prometheus", "Python", "Disaster Recovery"],
  },
  {
    role: "Senior Software Engineer",
    company: "Wipro (Client: Apple Inc.)",
    period: "Dec 2020 — July 2022",
    presentlyWorking: false,
    summary:
      "Engineered mission-critical ETL data pipelines and distributed analytics infrastructure for Apple Inc. Scaled containerized Kubernetes microservices processing high-velocity time-series datasets with full-stack observability.",
    tags: ["Data Engineering", "Kubernetes", "MongoDB", "Splunk & Grafana", "Python", "Tableau"],
  },
  {
    role: "Technology Lead",
    company: "Elait IT Technologies",
    period: "Nov 2015 — Dec 2020",
    presentlyWorking: false,
    summary:
      "Spearheaded software architecture, backend system design, and engineering delivery for scalable enterprise platforms. Led engineering teams in building high-throughput Python REST APIs, custom ANTLR4 parsers, and automated CI/CD infrastructure.",
    tags: ["System Architecture", "Python APIs", "ANTLR4", "Microservices", "CI/CD"],
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="space-y-12 sm:space-y-16">
    <!-- Hero Section -->
    <section class="flex flex-col items-center text-center max-w-2xl mx-auto space-y-6 pt-2">
      <!-- Profile Avatar -->
      <div class="relative group">
        <div class="absolute -inset-0.5 rounded-full bg-gradient-to-r from-sky-400 via-pink-400 to-amber-400 opacity-60 blur-sm group-hover:opacity-90 transition duration-300"></div>
        <img
          class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover object-center shadow-xl ring-4 ring-white/80 dark:ring-slate-800"
          src="/gokul-avatar.jpg"
          alt="Gokul Venkatesan"
          width="128"
          height="128"
        />
      </div>

      <!-- Identity & Bio -->
      <div class="space-y-3">
        <div class="flex flex-wrap items-center justify-center gap-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Software Engineer • AI Engineering & SRE Operations @ Cisco
          </div>
          <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-slate-500/10 text-slate-700 dark:text-slate-300 border border-slate-500/20">
            <span>📍 Bengaluru, India</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20">
            <span>⚡ GenAI, Azure AI & AWS Certified</span>
          </div>
        </div>
        <h1 class="page-title">Gokul Venkatesan</h1>
        <p class="body-text max-w-xl mx-auto">
          Software Engineer with {experienceYears} years of experience designing, architecting, and optimizing scalable systems. Focused on modern full-stack development, Generative AI engineering, and intelligent operations (AIOps) for enterprise platforms.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-1">
        <a
          href="/about"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:bg-sky-600 dark:hover:bg-sky-400 hover:text-white dark:hover:text-slate-900 shadow-md hover:shadow-lg transition-all"
        >
          <span>View Career & Skills</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="/resume.pdf"
          target="_blank"
          download="Gokul_Venkatesan_Resume.pdf"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white/60 dark:bg-slate-800/60 text-slate-800 dark:text-slate-200 border border-slate-900/10 dark:border-white/10 hover:border-sky-400 hover:text-sky-600 dark:hover:text-sky-400 shadow-sm transition-all"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Resume (PDF)</span>
        </a>
        <a
          href="mailto:gokul.venkatesan@outlook.com"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white/60 dark:bg-slate-800/60 text-slate-800 dark:text-slate-200 border border-slate-900/10 dark:border-white/10 hover:border-sky-400 hover:text-sky-600 dark:hover:text-sky-400 transition-all"
        >
          <span>Mail Me</span>
        </a>
      </div>

      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap justify-center gap-2 pt-2 max-w-lg">
        {coreSkills.map((skill) => (
          <Chips label={skill} variant="subtle" />
        ))}
      </div>

      <!-- Socials -->
      <Socials />
    </section>

    <!-- Engineering Disciplines -->
    <section class="space-y-4">
      <div class="text-center">
        <h2 class="section-title justify-center">Core Competencies</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        <div class="glass-card p-5 space-y-2">
          <div class="w-8 h-8 rounded-lg bg-sky-500/10 dark:bg-sky-400/20 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-sm font-mono">
            01
          </div>
          <h3 class="card-title">
            Software Development & Systems Architecture
          </h3>
          <p class="body-text">
            Designing robust backends, microservices, and REST APIs with Python, Node.js, and TypeScript. Expert in data modeling, containerized orchestration, and scalable system patterns.
          </p>
        </div>

        <div class="glass-card p-5 space-y-2">
          <div class="w-8 h-8 rounded-lg bg-sky-500/10 dark:bg-sky-400/20 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-sm font-mono">
            02
          </div>
          <h3 class="card-title">
            AI Engineering & Intelligent Automation
          </h3>
          <p class="body-text">
            Integrating Generative AI and LLM workflows into enterprise platforms. Building automated controller workflows, intelligent policy automation, and custom toolchains that reduce operational friction.
          </p>
        </div>

        <div class="glass-card p-5 space-y-2">
          <div class="w-8 h-8 rounded-lg bg-sky-500/10 dark:bg-sky-400/20 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-sm font-mono">
            03
          </div>
          <h3 class="card-title">
            AIOps & Platform Reliability (Customer Zero)
          </h3>
          <p class="body-text">
            Operating mission-critical network platforms (Catalyst Center, NSO, FMC, Splunk Observability, ThousandEyes) as Customer Zero. Leading enterprise security, zero-downtime upgrades, and comprehensive telemetry.
          </p>
        </div>
      </div>
    </section>

    <!-- Experience Snapshot -->
    <section class="space-y-4">
      <div class="flex items-end justify-between border-b border-black/5 dark:border-white/5 pb-3">
        <div>
          <h2 class="section-title">Experience Overview</h2>
          <p class="body-text mt-1 text-slate-500 dark:text-slate-400">
            Proven software engineering and platform leadership across global enterprises.
          </p>
        </div>
        <a
          href="/about"
          class="meta-text hover:underline inline-flex items-center gap-1 whitespace-nowrap"
        >
          Full Details
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="space-y-3 sm:space-y-4">
        {highlights.map((item) => (
          <div class="glass-card p-4 sm:p-5 space-y-2.5">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 border-b border-black/5 dark:border-white/5 pb-2">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="card-title">
                  {item.role}
                </h3>
                <span class="meta-text">
                  @{item.company}
                </span>
                {item.presentlyWorking && (
                  <span class="caption-text font-mono inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400 border border-emerald-500/30">
                    Present
                  </span>
                )}
              </div>
              <div class="caption-text font-semibold whitespace-nowrap sm:text-right">
                {item.period}
              </div>
            </div>

            <p class="body-text">
              {item.summary}
            </p>

            {item.tags && item.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 pt-1">
                {item.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-mono font-medium bg-slate-900/5 dark:bg-white/10 text-slate-700 dark:text-slate-300 border border-slate-900/10 dark:border-white/10">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>